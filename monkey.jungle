# Daily Verse — Connect IQ jungle project file
project.manifest = manifest.xml

# Base resources for all devices
base.sourcePath = source
base.resourcePath = resources

# Language overlays. The default jungle already maps resources-<lang> folders
# onto base.lang.<lang>, so resources-eng needs no explicit instruction here.

# Round display size tweaks (padding / font scale via layouts)
round-416x416.resourcePath = $(base.resourcePath);resources-round-416x416
round-390x390.resourcePath = $(base.resourcePath);resources-round-390x390
round-454x454.resourcePath = $(base.resourcePath);resources-round-454x454
round-360x360.resourcePath = $(base.resourcePath);resources-round-360x360

# Launcher icon overrides. The base resource is 40x40; devices that expect a
# larger icon get a natively rendered one so the firmware never has to upscale.
# Sizes come from launcherIcon in each device's compiler.json; regenerate the
# PNGs with tools/gen_icons.py.

# 60x60
epix2.resourcePath = $(epix2.resourcePath);resources-icon-60
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-icon-60
epix2pro47mm.resourcePath = $(epix2pro47mm.resourcePath);resources-icon-60
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-icon-60
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-icon-60
fr265.resourcePath = $(fr265.resourcePath);resources-icon-60
fr265s.resourcePath = $(fr265s.resourcePath);resources-icon-60

# 61x61
venu2s.resourcePath = $(venu2s.resourcePath);resources-icon-61

# 65x65
fenix847mm.resourcePath = $(fenix847mm.resourcePath);resources-icon-65
fenix8pro47mm.resourcePath = $(fenix8pro47mm.resourcePath);resources-icon-65
fr965.resourcePath = $(fr965.resourcePath);resources-icon-65

# 70x70
venu2.resourcePath = $(venu2.resourcePath);resources-icon-70
venu2plus.resourcePath = $(venu2plus.resourcePath);resources-icon-70
venu3.resourcePath = $(venu3.resourcePath);resources-icon-70
venu3s.resourcePath = $(venu3s.resourcePath);resources-icon-70
