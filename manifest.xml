<?xml version="1.0"?>
<!--
    Daily Verse — Connect IQ watch-app manifest. Version 1.0.0.
    Target: modern round watches (CIQ 4.0+).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="5af97fbc-6678-4ebe-8e0a-2cddfca4a32b"
        type="watch-app"
        name="@Strings.AppName"
        entry="DailyVerseApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="4.0.0">

        <iq:products>
            <!-- fenix 7 family -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <!-- Forerunner -->
            <iq:product id="fr255"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr255sm"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <!-- Venu -->
            <iq:product id="venu2"/>
            <iq:product id="venu2s"/>
            <iq:product id="venu2plus"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>deu</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
