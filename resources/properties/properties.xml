<properties>
    <!-- Shown read-only in the settings. Default for fresh installs; the app
         overwrites it with Rez.Strings.AppVersion on start (stored values
         survive updates). Keep in sync with AppVersion and CHANGELOG.md. -->
    <property id="appVersion" type="string">1.2.1</property>

    <!-- Catalog position of the language in Translations.languageIds() ("de"). -->
    <property id="languageIndex" type="number">6</property>
    <!-- Catalog position of the translation; 0 = random, 13 = "lut" (Luther 2017). -->
    <property id="translationIndex" type="number">13</property>

    <property id="slot1Enabled" type="boolean">true</property>
    <property id="slot1Hour" type="number">8</property>
    <property id="slot1Minute" type="number">0</property>

    <property id="slot2Enabled" type="boolean">false</property>
    <property id="slot2Hour" type="number">12</property>
    <property id="slot2Minute" type="number">0</property>

    <property id="slot3Enabled" type="boolean">false</property>
    <property id="slot3Hour" type="number">20</property>
    <property id="slot3Minute" type="number">0</property>
</properties>
